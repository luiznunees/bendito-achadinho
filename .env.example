# Copie este arquivo para .env.local e preencha os valores reais.
# .env.local nunca deve ser commitado (já está no .gitignore).

# --- Supabase (Project Settings → API no painel do Supabase) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- API de Afiliados da Shopee (Programa de Afiliados / Open API) ---
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

# --- Google Gemini (chave gratuita em https://aistudio.google.com) ---
GEMINI_API_KEY=

# --- Evolution API (sua instância na VPS) ---
EVOLUTION_API_URL=
EVOLUTION_INSTANCE_NAME=
EVOLUTION_INSTANCE_TOKEN=

# --- Segurança do bot ---
# Token que só você conhece, usado na URL do webhook (?token=...)
WEBHOOK_SHARED_SECRET=
# Seu número de WhatsApp (só dígitos, com DDI+DDD, ex: 5511999999999)
# É o único número autorizado a cadastrar produtos pelo bot.
OWNER_WHATSAPP_NUMBER=

# --- Painel de admin (admin.html) ---
# Senha do painel (usuário pode ser qualquer coisa, só a senha importa)
ADMIN_PASSWORD=

# --- Automação de publicação automática (AUTO-PUBLISH) ---
# Token que protege o endpoint /api/auto-publish (chamado pelo Vercel Cron).
# Inove uma string aleatória. O Vercel Cron chama a rota sem token; para
# disparos manuais, use GET/POST /api/auto-publish?token=DEFAULT... 
# O Vercel Cron adiciona o header "x-vercel-cron" em chamadas agendadas.
AUTOPUBLISH_TOKEN=

# Palavras-chave de busca na Shopee (separadas por vírgula). Cada uma
# vira uma busca no productOfferV2. Nicho cristão (católico + evangélico),
# português do Brasil acentuado. Ajuste/remova conforme o foco desejado.
AUTOPUBLISH_KEYWORDS=terço,terço de madeira,rosário,medalha,escapulário,imagem de santo,camiseta católica,caneca católica,chaveiro católico,bíblia,bíblia de estudo,catecismo,camiseta gospel,caneca gospel,blusa evangélica,livro evangélico,adesivo gospel,chaveiro gospel,caneca cristã,camiseta cristã,adesivo cristão,pulseira cristã,livro de oração

# Filtros de seleção de ofertas
AUTOPUBLISH_MIN_DISCOUNT=20      # desconto mínimo em %
AUTOPUBLISH_MIN_PRICE=5          # preço mínimo (R$)
AUTOPUBLISH_MAX_PRICE=300        # preço máximo (R$)
AUTOPUBLISH_MIN_COMMISSION=0     # comissão mínima em %

# Filtro de nicho cristão: se "true", só aceita produto cujo título contenha
# ao menos um termo da lista AUTOPUBLISH_NICHE_TERMS (bloqueia ruído vindo de
# keywords genéricas, ex.: "Pingente Medusa").
AUTOPUBLISH_REQUIRE_NICHE=true
# Termos cristãos (pt-BR, acentuados) usados nesse filtro, separados por vírgula.
AUTOPUBLISH_NICHE_TERMS=santo,santa,terço,terco,rosário,rosario,bíblia,biblia,cristão,crista,católico,catolica,evangélico,evangelica,gospel,jesus,cruz,crucifixo,medalha,escapulário,escapulario,oração,oracao,fé,fe,devocional,nossa senhora,aparecida,padre,sagrado

# Termos de EXCLUSÃO: se o título contiver qualquer um, descarta a oferta
# (bloqueia ruído de outras religiões/ocultismo, ex.: "Pingente da Medusa").
AUTOPUBLISH_BLOCK_TERMS=medusa,horus,ankh,olho de horus,buda,budismo,allah,islamica,islamico,islâmica,islâmico,maomé,maome,umbanda,espiritualismo,pachamama,satan,demonio,demônio,esqueleto,caveira,oculto,esoterico,esotérico,mágica,magica,energia,cristal

# Quantidade máxima de ofertas publicadas por execução
AUTOPUBLISH_MAX_OFFERS=5

# Ordenação: 1=relevância, 2=vendidos, 4=menor preço, 5=comissão
AUTOPUBLISH_SORT_TYPE=5

# Enviar imagem junto? ("true"/"false")
AUTOPUBLISH_SEND_IMAGE=false

# Modo de teste: se "true", NÃO publica no grupo nem salva no site,
# apenas lista as ofertas que encontraria (dry run).
AUTOPUBLISH_DRY_RUN=false

# Rodapé de marca adicionado ao final de cada oferta no grupo.
AUTOPUBLISH_GROUP_FOOTER=

# Cupom de desconto exibido na mensagem (se vazio, não aparece).
AUTOPUBLISH_COUPON=

# Gera headline chamativa + título curto com o Gemini ("true"/"false").
AUTOPUBLISH_HEADLINE=true

# Atraso (em segundos) entre mensagens no grupo
AUTOPUBLISH_SEND_DELAY=8

# ID do grupo de ofertas do WhatsApp (termina em @g.us, ex:
# 5511999999999-1234567890@g.us). A automação publica aqui.
GROUP_WHATSAPP_ID=

# --- Controle do switch geral (painel admin) ---
# "true" = automação ligada (cron + webhook), "false" = tudo pausado.
# No painel, é alterado via toggle. No Vercel, pode forçar via env.
AUTOPUBLISH_ENABLED=true

# Pausa temporária: data/hora ISO até quando a automação fica pausada.
# Deixe vazio para não pausar. Ex: 2026-09-03T11:00:00.000Z (08h BRT).
# Gerenciado pelo botão "Pausar até amanhã" no painel.
AUTOPUBLISH_PAUSED_UNTIL=

# URL do site (para imagens de saudação). Ex: https://bendito-achadinho.vercel.app
SITE_URL=
