# Copie este arquivo para .env.local e preencha os valores reais.
# .env.local nunca deve ser commitado (já está no .gitignore).

# --- Supabase (Project Settings → API no painel do Supabase) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- API de Afiliados da Shopee (Programa de Afiliados / Open API) ---
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

# --- Google Gemini (chave gratuita em https://aistudio.google.com) ---
GEMINI_API_KEY=

# --- Evolution API (sua instância na VPS) ---
EVOLUTION_API_URL=
EVOLUTION_INSTANCE_NAME=
EVOLUTION_INSTANCE_TOKEN=

# --- Segurança do bot ---
# Token que só você conhece, usado na URL do webhook (?token=...)
WEBHOOK_SHARED_SECRET=
# Seu número de WhatsApp (só dígitos, com DDI+DDD, ex: 5511999999999)
# É o único número autorizado a cadastrar produtos pelo bot.
OWNER_WHATSAPP_NUMBER=

# --- Painel de admin (admin.html) ---
# Senha do painel (usuário pode ser qualquer coisa, só a senha importa)
ADMIN_PASSWORD=
